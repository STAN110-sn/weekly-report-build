## Weekly Report (local) environment variables example
## Copy this file to `.env` and fill in values.
## IMPORTANT: `.env` must NOT be committed to git.

# Google Spreadsheet
SPREADSHEET_ID=
SHEET_NAME=Weekly_report_datas

# Google Drive folders (shared drive subfolders)
GENERAL_FOLDER_ID=
EXEC_FOLDER_ID=
LOGS_FOLDER_ID=

# Backward compatibility (optional)
OUTPUT_FOLDER_ID=

# Unsung Fields API
UF_API_ENDPOINT=https://dev.ufcloud.ai/openai/v1
UF_API_KEY=
UF_MODEL=openai/gpt-oss-120b

# Slack (general)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#internal-tools_dev

# Slack (executive) - optional (Exec report runs only if all 3 are set)
EXEC_SLACK_WEBHOOK_URL=
EXEC_SLACK_CHANNEL=

# Test/Development mode (optional)
# Set DRY_RUN=true to skip Slack notifications during testing
# This prevents sending test notifications to production channels
# For production, set to false or leave commented out
# DRY_RUN=true

# Google Cloud authentication
# ローカル: サービスアカウントキーのファイルパスを指定
GOOGLE_APPLICATION_CREDENTIALS=credential/your-service-account-key.json
# Build/Heroku等ファイルを置けない環境: JSONをそのまま、またはbase64エンコードして指定
# base64エンコード方法: cat your-key.json | base64
# GOOGLE_CREDENTIALS_JSON=
